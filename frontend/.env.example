# Optional — copy to frontend/.env and restart Metro (or rebuild for EAS).

# --- API (required on a physical phone — use your Mac's LAN IP, not localhost) ---
# Find IP: System Settings → Network, or run: ipconfig getifaddr en0
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8001/api/v1

# --- Store / production UI ---
# Hide demo Google button for review builds (guest still available)
# EXPO_PUBLIC_HIDE_DEMO_GOOGLE=1

# --- Legal URLs (host docs/legal/*.md on your site before store submission) ---
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://yourdomain.com/privacy
# EXPO_PUBLIC_TERMS_OF_USE_URL=https://yourdomain.com/terms
# EXPO_PUBLIC_SUPPORT_URL=mailto:support@yourdomain.com

# --- Observability (EAS dev/prod builds only — not Expo Go) ---
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
