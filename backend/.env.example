# Database - use SQLite for local dev (no setup required), or PostgreSQL for production
# SQLite (creates roofvision.db in backend folder):
DATABASE_URL=sqlite:///./roofvision.db
# PostgreSQL (create DB first: createdb roofvision, or docker compose up -d postgres):
# DATABASE_URL=postgresql://roofvision:roofvision@localhost:5432/roofvision

# Optional
DEBUG=false
ENVIRONMENT=development

# --- CORS (browser). Unset = * (dev only). Production: list your web origins, comma-separated.
# CORS_ORIGINS=https://your-web-client.example,http://localhost:8090

# --- Rate limit: POST /visualizations per IP (SlowAPI), e.g. 20/minute, 100/hour
# RATE_LIMIT_UPLOAD=30/minute

# --- Object storage (local | gcs | s3). See docs/DEPLOY.md ---
STORAGE_BACKEND=local
# STORAGE_BACKEND=gcs
# GCS_BUCKET=your-bucket
# GCS_PROJECT=your-gcp-project
# GCS_CREDENTIALS_PATH=/path/to/service-account.json
# STORAGE_PUBLIC_BASE_URL=https://cdn.yourdomain.com/uploads
# STORAGE_BACKEND=s3
# S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=

# --- Observability (optional) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Image generation (see docs/IMAGE-GEN-API.md) ---
# mock = copy uploaded image as "result" (no external API — best for UI dev)
IMAGE_GEN_PROVIDER=mock
# IMAGE_GEN_PROVIDER=gemini
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gemini-3.1-flash-image-preview
IMAGE_GEN_TIMEOUT_SECONDS=180
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_RETRY_BACKOFF_SECONDS=1.5
